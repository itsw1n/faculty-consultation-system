# Copy to .env or .env.local. Never commit real credentials.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Use a verified sender domain for delivery to test recipients.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Server only. Never expose with a NEXT_PUBLIC_ prefix. Designates the single
# Google account allowed to claim the first administrator role after sign-in.
INITIAL_ADMIN_EMAIL=
